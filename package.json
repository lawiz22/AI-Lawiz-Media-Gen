{
  "name": "lawiz's-media-generator-v-2",
  "private": true,
  "version": "1.88.0",
  "license": "SEE LICENSE IN LICENSING.md",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"components/**/*.test.mjs\" \"services/**/*.test.mjs\" \"utils/**/*.test.mjs\" \"electron/**/*.test.cjs\"",
    "typecheck": "tsc --noEmit",
    "check:locks": "node scripts/browser/lock-release-check.mjs",
    "check:tabs": "node scripts/browser/tab-switch-audit.mjs",
    "check:tab-jobs": "node scripts/browser/tab-switch-job-check.mjs",
    "check:ui": "node scripts/browser/ui-kit-check.mjs",
    "check:panels": "node scripts/browser/panel-controls-audit.mjs",
    "profile:renders": "node scripts/browser/app-render-profile.mjs",
    "electron:dev": "node electron/dev.cjs",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@google/genai": "2.20.0",
    "@mediapipe/tasks-vision": "0.10.14",
    "@reduxjs/toolkit": "2.12.0",
    "@streamparser/json": "^0.0.26",
    "@zip.js/zip.js": "^2.8.2",
    "electron-store": "^11.0.2",
    "framer-motion": "13.1.1",
    "hash-wasm": "^4.12.0",
    "idb": "8.0.0",
    "jszip": "3.10.1",
    "react": "19",
    "react-dom": "19",
    "react-image-crop": "11.0.5",
    "react-redux": "9.2.0",
    "url": "0.11.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.0.12",
    "fake-indexeddb": "^6.2.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "LICENSING.md"
    ],
    "asar": true
  }
}
